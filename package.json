{
  "name": "jalan-lasak",
  "private": true,
  "description": "Peta program Jalan Lasak — Cloudflare Pages + Functions + D1",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init": "wrangler d1 execute jalan-lasak --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute jalan-lasak --remote --file=schema.sql",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
